  "issues": {
    "appliance_removed": {
      "title": "{name} is no longer on your Sub-Zero account",
      "description": "Your Sub-Zero account no longer lists {name}, so it can't report to Home Assistant.\n\nIf you removed it from your account, open the Sub-Zero integration, select **Configure**, and deselect it. If it should still be there, add it again in the Sub-Zero Group Owner's App. This message goes away once Home Assistant finds it on your account again."
    },
    "firebase_alerts_failing": {
      "title": "Firebase appliance alerts aren't working",
      "description": "Home Assistant couldn't set up Firebase appliance alerts for {name} after several tries. Your appliances still report through the live connection, but an alert that only Firebase delivers can arrive late or not at all.\n\nHome Assistant keeps trying, and this message goes away once it succeeds. To stop using Firebase alerts, open the Sub-Zero integration, select **Configure**, and turn off **Firebase appliance alerts**."
    }
  }
